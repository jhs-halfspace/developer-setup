# Lightweight Zsh Configuration
# No heavy frameworks - just the essentials

# =============================================================================
# PATH Configuration
# =============================================================================

export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH
export PATH="$PATH":"$HOME/.pub-cache/bin"

# PostgreSQL
export PATH="/opt/homebrew/opt/postgresql@17/bin:$PATH"
export LDFLAGS="-L/opt/homebrew/opt/postgresql@17/lib"
export CPPFLAGS="-I/opt/homebrew/opt/postgresql@17/include"

# Java
export PATH="/opt/homebrew/opt/openjdk@21/bin:$PATH"

# Go
command -v mise &>/dev/null && eval "$(mise activate zsh)"
command -v go &>/dev/null && export PATH="$(go env GOPATH)/bin:$PATH"

# Android SDK
export ANDROID_HOME="$HOME/Library/Android/sdk"
export PATH="$ANDROID_HOME/platform-tools:$PATH"
export PATH="$ANDROID_HOME/tools:$PATH"

# =============================================================================
# Homebrew
# =============================================================================

eval "$(/opt/homebrew/bin/brew shellenv)"

# =============================================================================
# Zsh Plugins (sourced directly from Homebrew)
# =============================================================================

source "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
source "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# =============================================================================
# Completions
# =============================================================================

autoload bashcompinit && bashcompinit
autoload -Uz compinit && compinit

# AZ CLI
source ~/.azure-cli-venv/bin/az.completion.sh 2>/dev/null || true

# AWS CLI
complete -C '/usr/local/bin/aws_completer' aws

# Halfspace CLI
# add if statement to check if halfspace is installed before enabling completion
if command -v halfspace &> /dev/null; then
  eval "$(halfspace completion zsh)"
fi

# =============================================================================
# NVM (Node Version Manager)
# =============================================================================

export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"

# =============================================================================
# Terminal Settings
# =============================================================================

export COLORTERM=truecolor
export CLICOLOR=1
export EDITOR=nvim
export VISUAL=nvim

# Herdr hardcodes TERM=xterm-256color in panes; Ghostty's terminfo
# is what Cursor Agent / nvim expect for truecolor and mode colors.
if [[ "${HERDR_ENV:-}" == "1" && "$TERM" == "xterm-256color" ]]; then
  export TERM=xterm-ghostty
fi

# =============================================================================
# Dotfiles root (this file lives in <repo>/dotfiles/zshrc)
# $0 is the shell name when .zshrc is sourced; %x is this file.
# =============================================================================

export DEV_SETUP_DIR="${${(%):-%x}:A:h:h}"

# =============================================================================
# Git Aliases (Oh-My-Zsh style)
# =============================================================================

source "$DEV_SETUP_DIR/dotfiles/git_aliases.zsh"

# =============================================================================
# Aliases
# =============================================================================

alias pycharm="open -na \"PyCharm.app\""
alias git_remove_branches="tmp=\$(mktemp) && git branch --format='%(refname:short)' | grep -v '^main$' > \$tmp && vim \$tmp && cat \$tmp | xargs git branch -D && rm \$tmp"
alias ll="ls -lhF"

# =============================================================================
# Functions
# =============================================================================

# rune: Presenter mode with configurable zoom levels
# Usage: rune [level]
#   rune     - Toggle between OFF and level 1 (120%)
#   rune 0   - Disable zoom (100% / default font size)
#   rune 1   - 120% zoom
#   rune 2   - 140% zoom
#   rune N   - (100 + N*20)% zoom
rune() {
  local state_file="$HOME/.rune_level"
  local override_file="$HOME/.config/ghostty/rune-override"
  local base_font_size=14
  local level="$1"
  
  # Handle toggle mode (no argument)
  if [[ -z "$level" ]]; then
    if [[ -f "$state_file" ]]; then
      level=0  # Currently on, turn off
    else
      level=1  # Currently off, turn on to level 1
    fi
  fi
  
  # Validate level is a non-negative integer
  if ! [[ "$level" =~ ^[0-9]+$ ]]; then
    echo "Error: Level must be a non-negative integer"
    return 1
  fi
  
  # Apply zoom BEFORE animation to prevent hopping
  local zoom_percent=100
  local font_size="$base_font_size"
  
  if [[ "$level" -eq 0 ]]; then
    # Disable zoom - remove override file and state
    rm -f "$override_file" "$state_file"
  else
    # Calculate font size: base * (1 + level * 0.2)
    zoom_percent=$((100 + level * 20))
    font_size=$(echo "scale=1; $base_font_size * $zoom_percent / 100" | bc)
    
    # Write override config
    echo "font-size = $font_size" > "$override_file"
    
    # Save current level
    echo "$level" > "$state_file"
  fi
  
  # Trigger Ghostty config reload (Cmd+Shift+,)
  osascript -e 'tell application "System Events" to keystroke "," using {command down, shift down}' 2>/dev/null
  
  # Small delay to let Ghostty apply the new font size
  sleep 0.1
  
  # ANSI color codes
  local DIM='\033[90m'
  local BLUE='\033[34m'
  local BRIGHT_BLUE='\033[94m'
  local RESET='\033[0m'
  
  # ASCII art lines
  local lines=(
    '╔══════════════════════════════════════╗'
    '║  ██████╗ ██╗   ██╗███╗   ██╗███████╗ ║'
    '║  ██╔══██╗██║   ██║████╗  ██║██╔════╝ ║'
    '║  ██████╔╝██║   ██║██╔██╗ ██║█████╗   ║'
    '║  ██╔══██╗██║   ██║██║╚██╗██║██╔══╝   ║'
    '║  ██║  ██║╚██████╔╝██║ ╚████║███████╗ ║'
    '║  ╚═╝  ╚═╝ ╚═════╝ ╚═╝  ╚═══╝╚══════╝ ║'
    '╚══════════════════════════════════════╝'
  )
  local num_lines=${#lines[@]}
  
  # Ensure cursor is restored on interrupt
  trap 'printf "\033[?25h"' INT TERM
  
  # Clear screen and hide cursor
  clear
  printf '\033[?25l'
  
  # Phase 1: Line-by-line reveal in dim color (~240ms)
  for line in "${lines[@]}"; do
    printf "${DIM}%s${RESET}\n" "$line"
    sleep 0.03
  done
  
  # Phase 2: Color pulse - bright blue (~75ms)
  printf "\033[${num_lines}A"  # Move cursor back up
  for line in "${lines[@]}"; do
    printf "${BRIGHT_BLUE}%s${RESET}\n" "$line"
  done
  sleep 0.075
  
  # Phase 3: Settle to normal blue (~75ms)
  printf "\033[${num_lines}A"  # Move cursor back up
  for line in "${lines[@]}"; do
    printf "${BLUE}%s${RESET}\n" "$line"
  done
  sleep 0.075
  
  # Show cursor again
  printf '\033[?25h'
  trap - INT TERM
  
  # Display status
  echo ""
  if [[ "$level" -eq 0 ]]; then
    echo "  Status: OFF"
    echo "  Zoom:   100% (${base_font_size}pt)"
  else
    echo "  Status: ON"
    echo "  Level:  $level"
    echo "  Zoom:   ${zoom_percent}% (${font_size}pt)"
  fi
}

if command -v wt >/dev/null 2>&1; then
  eval "$(command wt config shell init zsh)"
fi

# =============================================================================
# Machine/client-specific config (not in git)
# =============================================================================

[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

# =============================================================================
# Starship Prompt (must be at the end)
# =============================================================================

eval "$(starship init zsh)"

# bun completions
[ -s "~/.bun/_bun" ] && source "~/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
