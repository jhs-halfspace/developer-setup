# Core: everything the configs in this repo depend on.
# Install with: brew bundle --file=Brewfile

# --- Shell (dotfiles/zshrc) ---------------------------------------------------
# Cross-shell prompt (starship/starship.toml)
brew "starship"
# Fish-like fast/unobtrusive autosuggestions for zsh
brew "zsh-autosuggestions"
# Fish shell like syntax highlighting for zsh
brew "zsh-syntax-highlighting"

# --- Git (dotfiles/git_aliases.zsh) -------------------------------------------
# Distributed revision control system (newer than Apple's)
brew "git"
# GitHub command-line tool
brew "gh"
# Git worktree management: `wt`, plus the wts/wtl aliases
brew "worktrunk"

# --- Everyday CLI -------------------------------------------------------------
# $EDITOR / $VISUAL
brew "neovim"
# Command-line fuzzy finder
brew "fzf"
# Simple, fast and user-friendly alternative to find
brew "fd"

# --- Languages ----------------------------------------------------------------
# Python interpreters and packages (primary)
brew "uv"
# Python package management for older projects
brew "poetry"
# Node version manager (zshrc loads it from /opt/homebrew/opt/nvm)
brew "nvm"

# --- Terminal & apps ----------------------------------------------------------
# Terminal emulator (ghostty/config)
cask "ghostty"
# Ghostty-based terminal with vertical tabs for AI agents (shares ghostty/config)
cask "cmux"
# Font with icons for starship's prompt glyphs
cask "font-jetbrains-mono-nerd-font"
# Terminal-based AI coding assistant
cask "claude-code"
